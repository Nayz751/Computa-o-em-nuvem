{
  "family": "tracemark-worker",
  "requiresCompatibilities": ["EC2"],
  "networkMode": "bridge",
  "taskRoleArn": "arn:aws:iam::SUA_CONTA:role/tracemark-worker-task-role",
  "executionRoleArn": "arn:aws:iam::SUA_CONTA:role/ecsTaskExecutionRole",
  "cpu": "512",
  "memory": "512",
  "containerDefinitions": [
    {
      "name": "tracemark-worker",
      "image": "SUA_CONTA.dkr.ecr.us-east-2.amazonaws.com/tracemark-worker:latest",
      "essential": true,
      "environment": [
        { "name": "AWS_REGION", "value": "us-east-2" },
        { "name": "QUEUE_URL", "value": "https://sqs.us-east-2.amazonaws.com/SUA_CONTA/NOME_DA_FILA" },
        { "name": "DATABASE_URL", "value": "postgres://USUARIO:SENHA@ENDPOINT_DO_RDS:5432/tracemark" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/tracemark-worker",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "worker"
        }
      }
    }
  ]
}
